<?xml version="1.0" encoding="utf-8"?>
<!--
    Modern (Android 12+) data extraction rules. Excludes MEGA's
    app-private data from BOTH cloud backup and device-to-device
    transfer. See docs/STORAGE-DESIGN.md.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
