<?xml version="1.0" encoding="utf-8"?>
<!--
    MEGA requests NO dangerous permissions and, critically, NO
    android.permission.INTERNET. This is verified by the
    `securityAudit` Gradle task (app/build.gradle.kts) and by
    docs/NO-RNG-PROOF.md. Backup is disabled through both the legacy
    android:allowBackup="false" flag AND the modern
    android:dataExtractionRules mechanism, per docs/STORAGE-DESIGN.md.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".MegaApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.MEGA"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        tools:targetApi="36">

        <!-- launchMode was previously "singleTask", which made Android reset
             this task to its root activity (Welcome) whenever the app was
             relaunched from the home-screen icon after being backgrounded —
             there's no second Activity here for singleTask to deduplicate,
             so it bought nothing but that reset behavior. standard +
             alwaysRetainTaskState keeps the Navigation-Compose back stack
             (and its saved instance state) intact across app switches. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MEGA"
            android:launchMode="standard"
            android:alwaysRetainTaskState="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
