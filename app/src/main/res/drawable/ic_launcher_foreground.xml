<?xml version="1.0" encoding="utf-8"?>
<!--
    Icon concept: an isometric 3D die — three visible faces (top, right,
    left) shaded to read as a cube, each showing a different pip count
    (1, 2, 3) the way most "die as logo" marks are drawn. Built entirely
    from flat path/circle shapes (three rhombi meeting at a shared center
    point, matching the classic isometric-cube construction) so no image
    asset or 3D rendering is needed — just vector paths.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- top face (lightest) -->
    <path
        android:fillColor="#F2C9A0"
        android:strokeColor="#15130F"
        android:strokeWidth="1.5"
        android:pathData="M26.29,38 L54,22 L81.71,38 L54,54 Z" />

    <!-- right face (mid-tone brand orange) -->
    <path
        android:fillColor="#E8792E"
        android:strokeColor="#15130F"
        android:strokeWidth="1.5"
        android:pathData="M81.71,38 L81.71,70 L54,86 L54,54 Z" />

    <!-- left face (darkest) -->
    <path
        android:fillColor="#A84E15"
        android:strokeColor="#15130F"
        android:strokeWidth="1.5"
        android:pathData="M26.29,38 L54,54 L54,86 L26.29,70 Z" />

    <!-- top face pip: "1" -->
    <path android:fillColor="#211C15"
        android:pathData="M54,38 m-4.6,0 a4.6,4.6 0 1,0 9.2,0 a4.6,4.6 0 1,0 -9.2,0" />

    <!-- right face pips: "2" -->
    <path android:fillColor="#FAF6EF"
        android:pathData="M73.4,52.4 m-4.6,0 a4.6,4.6 0 1,0 9.2,0 a4.6,4.6 0 1,0 -9.2,0" />
    <path android:fillColor="#FAF6EF"
        android:pathData="M62.31,71.6 m-4.6,0 a4.6,4.6 0 1,0 9.2,0 a4.6,4.6 0 1,0 -9.2,0" />

    <!-- left face pips: "3" -->
    <path android:fillColor="#FAF6EF"
        android:pathData="M33.22,66 m-4.6,0 a4.6,4.6 0 1,0 9.2,0 a4.6,4.6 0 1,0 -9.2,0" />
    <path android:fillColor="#FAF6EF"
        android:pathData="M40.14,62 m-4.6,0 a4.6,4.6 0 1,0 9.2,0 a4.6,4.6 0 1,0 -9.2,0" />
    <path android:fillColor="#FAF6EF"
        android:pathData="M47.07,58 m-4.6,0 a4.6,4.6 0 1,0 9.2,0 a4.6,4.6 0 1,0 -9.2,0" />
</vector>
