*.iml
.gradle/
/local.properties
.idea/
.DS_Store
/build
/captures
.externalNativeBuildOverride/
build/
!/gradle/wrapper/gradle-wrapper.jar
.cxx/
*.apk
*.aab
/tools/*.raw.json
# Belt-and-braces: the build FAILS outright if these exist in-tree (see
# app/build.gradle.kts) — signing secrets belong outside the repo per
# docs/RELEASE-SIGNING.md. These patterns only stop an accidental
# `git status` clutter before the build error fires.
/keystore.properties
/keystore/

# Kotlin compiler daemon session/build cache at the repo root (distinct
# from the already-ignored top-level /build and app/build/ etc. output
# dirs) — local machine state, not source.
/.kotlin/

# Parked/deferred feature code, pulled out of the active build (see
# shelved/seedqr/README.md for what and why) — not part of what ships,
# so it stays out of release commits the same way build output does.
# This is a .gitignore-only decision, not a deletion: nothing here is
# removed, and `git add -f shelved/` still works if that should change.
/shelved/
